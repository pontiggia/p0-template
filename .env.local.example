# Anthropic API Key
ANTHROPIC_API_KEY=your_key_here

# Postgres connection string
# Pontimpo Postgres — READ-ONLY role / read replica. Used by the analytics
# SQL-over-sandbox path AND by pontimpo/resolve.ts (number→PK lookups).
# Must have EXECUTE on execute_readonly_sql (see rpc-function.sql).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Vercel Sandbox (auto-authenticates via OIDC when deployed)
# For local dev: `vercel env pull`
VERCEL_SANDBOX_TOKEN=your_token_here

# --- Phase 9: WhatsApp agent ---

# Pontimpo agent API (corrections + correction-targeting reads)
PONTIMPO_API_URL=http://localhost:3000          # prod: https://app.pontimpo.com
PONTIMPO_API_KEY=your_scoped_agent_credential   # scopes: clients:read, sales:read, ledger:read, audit:read, sales:correct, payments:write
# PONTIMPO_STORE_ID=1                            # ONLY if the credential is store-unbound (sent as X-Store-Id)

# Kapso (WhatsApp transport)
KAPSO_API_KEY=your_kapso_api_key
KAPSO_PHONE_NUMBER_ID=your_phone_number_id
KAPSO_WEBHOOK_SECRET=your_webhook_signing_secret
# KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp

# Session store (Upstash Redis / Vercel KV) — thread history, pending actions, webhook dedupe
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Access control — JSON map of WhatsApp number → identity
# e.g. {"5492916123456":{"staffName":"Oscar","onBehalfOf":"oscar@lasflores.com"}}
STAFF_ALLOWLIST={}
